DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Portfolio entry pages
<IfModule mod_rewrite.c>
  RewriteEngine On
  # A CV bookmark may carry a language preference as well as an employer or tab.
  RewriteRule ^profile(?:\.(?:en|fa))?\.html$ - [E=Cache-Control:no-cache]
  RewriteRule ^solutions\.html$ strategy.html [R=302,L]
  RewriteRule ^home\.en\.html$ - [R=404,L]
  RewriteRule ^(?:(?:index(?:\.en)?|landing)\.html)?$ - [E=PORTFOLIO_HOME:1,E=Cache-Control:no-cache]

  # Legacy home bookmarks can identify a CV employer or tab.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:tab|role)(?:=|&|$)
  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{THE_REQUEST} \s/+index\.en\.html[?\s] [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^(?:(?:index(?:\.en)?|landing)\.html)?$ cv.en.html [R=302,L]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:tab|role)(?:=|&|$)
  RewriteRule ^(?:(?:index(?:\.en)?|landing)\.html)?$ cv.fa.html [R=302,L]

  # Redirect requested filenames, never the internal DirectoryIndex or English rewrite.
  RewriteCond %{THE_REQUEST} \s/+(?:index(?:\.en)?|landing)\.html[?\s]
  RewriteCond %{QUERY_STRING} (?:^|&)lang(?:=|&|$)
  RewriteRule ^(?:index(?:\.en)?|landing)\.html$ / [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+index\.en\.html[?\s]
  RewriteRule ^index\.en\.html$ /?lang=en [R=301,L,QSA,NE]

  # Readers with an unqualified bookmark may change their language preference later.
  RewriteCond %{QUERY_STRING} !(?:^|&)lang(?:=|&|$)
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^(?:(?:index|landing)\.html)?$ /?lang=en [R=302,L,QSA,NE]
  RewriteCond %{QUERY_STRING} !(?:^|&)lang(?:=|&|$)
  RewriteRule ^(?:(?:index|landing)\.html)?$ /?lang=fa [R=302,L,QSA,NE]

  # Old CV URLs only redirect; each final cv.* document always serves one language.
  RewriteCond %{QUERY_STRING} (?:^|&)lang=fa(?:&|$)
  RewriteRule ^profile(?:\.(?:en|fa))?\.html$ cv.fa.html [R=302,L]
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteRule ^profile(?:\.(?:en|fa))?\.html$ cv.en.html [R=302,L]
  RewriteRule ^profile\.(en|fa)\.html$ cv.$1.html [R=302,L]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^profile\.html$ cv.en.html [R=302,L]
  RewriteRule ^profile\.html$ cv.fa.html [R=302,L]

  # The explicit query wins over a stored preference. Keep role and filter parameters.
  RewriteCond %{QUERY_STRING} (?:^|&)lang=fa(?:&|$)
  RewriteRule ^(blog|strategy|execution|technology|ai-tools|contact|work-stories)\.en\.html$ $1.fa.html [R=302,L]
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteRule ^(blog|strategy|execution|technology|ai-tools|contact|work-stories)\.fa\.html$ $1.en.html [R=302,L]

  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^(blog|strategy|execution|technology|ai-tools|contact|work-stories)\.html$ $1.en.html [R=302,L]
  RewriteRule ^(blog|strategy|execution|technology|ai-tools|contact|work-stories)\.html$ $1.fa.html [R=302,L]

  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  # Keep the legacy English address separate from the file served at the canonical URL.
  RewriteRule ^(?:index\.html)?$ home-entry.php [END]
</IfModule>
<IfModule mod_authz_core.c>
  <Files "home.en.html">
    Require all denied
  </Files>
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store" env=PORTFOLIO_HOME
  Header always merge Vary Cookie env=PORTFOLIO_HOME
  <FilesMatch "^(?:index(?:\.en)?|landing|profile(?:\.(?:en|fa))?|blog|strategy|execution|technology|ai-tools|contact|work-stories)\.html$">
    Header unset Cache-Control
    Header always set Cache-Control "private, no-store"
    Header always merge Vary Cookie
  </FilesMatch>
</IfModule>
# End portfolio entry pages

# Portfolio reading routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Require a single article slug. The archive is also HTML in /reading/, but isn't a post.
  RewriteCond %{QUERY_STRING} !(?:^|&)post=[^&]*&(?:[^&]*&)*post=
  RewriteCond %{QUERY_STRING} (?:^|&)post=(?!archive(?:&|$))([a-z0-9]+(?:-[a-z0-9]+)*)(?:&|$)
  RewriteRule ^article\.html$ - [E=PORTFOLIO_POST:%1]
  RewriteCond %{ENV:PORTFOLIO_POST} !^$
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteCond %{DOCUMENT_ROOT}/reading/en/%{ENV:PORTFOLIO_POST}.html -f
  RewriteRule ^article\.html$ reading/en/%{ENV:PORTFOLIO_POST}.html [END]
  RewriteCond %{ENV:PORTFOLIO_POST} !^$
  RewriteCond %{QUERY_STRING} !(?:^|&)lang=en(?:&|$)
  RewriteCond %{DOCUMENT_ROOT}/reading/fa/%{ENV:PORTFOLIO_POST}.html -f
  RewriteRule ^article\.html$ reading/fa/%{ENV:PORTFOLIO_POST}.html [END]
  # Let the reading directory serve its error document with the original URL and status.
  RewriteRule ^article\.html$ reading/missing-article [L,QSD]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^myphoto-(avatar|profile)-v[0-9]+\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# End portfolio reading routes
