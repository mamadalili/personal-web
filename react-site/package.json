    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
