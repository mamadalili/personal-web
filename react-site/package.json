{
  "name": "personal-web-react",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-public.mjs",
    "predev": "npm run prepare:content",
    "dev": "react-router dev --host 127.0.0.1",
