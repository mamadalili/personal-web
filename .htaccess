DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|mjs)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Portfolio entry pages
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Older bookmarks used the home URL for a CV tab or employer.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:tab|role)(?:=|&|$)
  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^(?:index\.html)?$ profile.en.html [END]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:tab|role)(?:=|&|$)
  RewriteRule ^(?:index\.html)?$ profile.html [END]

  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^profile\.html$ profile.en.html [END]
  RewriteCond %{QUERY_STRING} !(?:^|&)lang=fa(?:&|$)
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [OR]
  RewriteCond %{HTTP_COOKIE} (?:^|;\s*)portfolio_language=en(?:;|$)
  RewriteRule ^(?:index\.html)?$ index.en.html [END]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(?:index|profile)(?:\.en)?\.html$">
    Header merge Vary Cookie
  </FilesMatch>
</IfModule>
# End portfolio entry pages

# Portfolio reading routes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (?:^|&)post=([a-z0-9]+(?:-[a-z0-9]+)*)(?:&|$)
  RewriteRule ^article\.html$ - [E=PORTFOLIO_POST:%1]
  RewriteCond %{ENV:PORTFOLIO_POST} !^$
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteCond %{DOCUMENT_ROOT}/reading/en/%{ENV:PORTFOLIO_POST}.html -f
  RewriteRule ^article\.html$ reading/en/%{ENV:PORTFOLIO_POST}.html [END]
  RewriteCond %{ENV:PORTFOLIO_POST} !^$
  RewriteCond %{DOCUMENT_ROOT}/reading/fa/%{ENV:PORTFOLIO_POST}.html -f
  RewriteRule ^article\.html$ reading/fa/%{ENV:PORTFOLIO_POST}.html [END]
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$)
  RewriteRule ^blog\.html$ reading/en/archive.html [END]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^myphoto-(avatar|profile)-v[0-9]+\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# End portfolio reading routes
